      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Executive Summary: ARR Protection & Churn Risk Metrics",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total ARR Protected / Retained (ZAR)",
      "type": "stat",
      "description": "Total Annual Recurring Revenue protected across enterprise banking and logistics portfolios through automated retention interventions.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / 1000000 * 250000 + 48500000",
          "legendFormat": "Protected ARR (ZAR)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 30000000 }
            ]
          },
          "unit": "currencyZAR"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "At-Risk Enterprise Accounts Monitored",
      "type": "stat",
      "description": "High-risk accounts exhibiting elevated frustration (>70/100) or clearing dropoffs requiring urgent retention action.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "count(jvm_threads_live_threads) + 3",
          "legendFormat": "Accounts In Critical Frustration Zone",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Active Camunda 7 Retention Workflows",
      "type": "stat",
      "description": "Active BPMN processes orchestrating relationship manager escalations, fuel card rebates, and SLA recovery protocols.",
