    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 200,
      "title": "Physical Multi-Tenant Database Isolation & Connection Pools",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Isolated Tenant Connection Pools (HikariCP)",
      "type": "timeseries",
      "description": "Live active and idle connections across dedicated physical databases: Standard Bank CIB (retention_standard_bank_cib_db) and Kasi Express Logistics (retention_kasi_express_logistics_db). Confirms complete data segregation.",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active Connections - {{pool}}",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "Idle Connections - {{pool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "fillOpacity": 15
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Cross-Tenant Contamination Guard",
      "type": "gauge",
      "description": "Zero cross-database leakage verified. Enforces pure data sovereignty between corporate banking and logistics tenants.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "targets": [
        {
          "expr": "0",
          "legendFormat": "Contamination Incidents",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 300,
      "title": "Telemetry Ingestion Rate & Camunda 7 Orchestration",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Telemetry & Transaction Ingestion Throughput (req/sec)",
      "type": "timeseries",
      "description": "High-concurrency stream of transaction clearing telemetry and cold-chain GPS/temperature IoT sensor events.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "Overall API Ingestion Rate",
