<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_CustomerRecoveryProcess"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="CustomerRecoveryProcess" name="Customer Recovery Process" isExecutable="true" camunda:historyTimeToLive="P180D">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerImported" name="Customer Imported">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. Run Detection Engine -->
    <bpmn:serviceTask id="Task_RunDetectionEngine" name="Run Detection Engine" camunda:delegateExpression="${runDetectionEngineDelegate}">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2. Evaluate Customer Value -->
    <bpmn:serviceTask id="Task_EvaluateCustomerValue" name="Evaluate Customer Value" camunda:delegateExpression="${evaluateCustomerValueDelegate}">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 3. Recommend Recovery Action -->
    <bpmn:serviceTask id="Task_RecommendRecoveryAction" name="Recommend Recovery Action" camunda:delegateExpression="${recommendRecoveryActionDelegate}">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Manager Approval Required? -->
    <bpmn:exclusiveGateway id="Gateway_ManagerApproval" name="Manager Approval Required?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApproval</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manager Approval User Task -->
    <bpmn:userTask id="Task_ManagerApproval" name="Manager Approval">
      <bpmn:incoming>Flow_ManagerApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Join">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4. Execute Recovery Action -->
    <bpmn:serviceTask id="Task_ExecuteRecoveryAction" name="Execute Recovery Action" camunda:delegateExpression="${executeRecoveryActionDelegate}">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 5. Wait for Outcome -->
    <bpmn:intermediateCatchEvent id="Event_WaitForOutcome" name="Wait for Outcome">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Wait30Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- 6. Close Recovery Case -->
    <bpmn:serviceTask id="Task_CloseRecoveryCase" name="Close Recovery Case" camunda:delegateExpression="${closeRecoveryCaseDelegate}">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CaseClosed" name="Case Closed">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_CustomerImported" targetRef="Task_RunDetectionEngine" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RunDetectionEngine" targetRef="Task_EvaluateCustomerValue" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EvaluateCustomerValue" targetRef="Task_RecommendRecoveryAction" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_RecommendRecoveryAction" targetRef="Gateway_ManagerApproval" />
    <bpmn:sequenceFlow id="Flow_ManagerApproval" sourceRef="Gateway_ManagerApproval" targetRef="Task_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresApproval == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApprove" sourceRef="Gateway_ManagerApproval" targetRef="Gateway_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresApproval == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ManagerApproval" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Join" targetRef="Task_ExecuteRecoveryAction" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ExecuteRecoveryAction" targetRef="Event_WaitForOutcome" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_WaitForOutcome" targetRef="Task_CloseRecoveryCase" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CloseRecoveryCase" targetRef="EndEvent_CaseClosed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_CustomerRecoveryProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_CustomerRecoveryProcess" bpmnElement="CustomerRecoveryProcess">
      
      <!-- Start Event Shape -->
      <bpmndi:BPMNShape id="Shape_StartEvent_CustomerImported" bpmnElement="StartEvent_CustomerImported">
        <dc:Bounds x="160" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="143" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Run Detection Engine -->
      <bpmndi:BPMNShape id="Shape_Task_RunDetectionEngine" bpmnElement="Task_RunDetectionEngine">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Evaluate Customer Value -->
      <bpmndi:BPMNShape id="Shape_Task_EvaluateCustomerValue" bpmnElement="Task_EvaluateCustomerValue">
        <dc:Bounds x="400" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Recommend Recovery Action -->
      <bpmndi:BPMNShape id="Shape_Task_RecommendRecoveryAction" bpmnElement="Task_RecommendRecoveryAction">
        <dc:Bounds x="550" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Manager Approval -->
      <bpmndi:BPMNShape id="Shape_Gateway_ManagerApproval" bpmnElement="Gateway_ManagerApproval" isMarkerVisible="true">
        <dc:Bounds x="700" y="93" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="56" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Manager Approval -->
      <bpmndi:BPMNShape id="Shape_Task_ManagerApproval" bpmnElement="Task_ManagerApproval">
        <dc:Bounds x="800" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Join -->
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="950" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task: Execute Recovery Action -->
      <bpmndi:BPMNShape id="Shape_Task_ExecuteRecoveryAction" bpmnElement="Task_ExecuteRecoveryAction">
        <dc:Bounds x="1050" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Catch Event: Wait for Outcome -->
      <bpmndi:BPMNShape id="Shape_Event_WaitForOutcome" bpmnElement="Event_WaitForOutcome">
        <dc:Bounds x="1200" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1176" y="143" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Close Recovery Case -->
      <bpmndi:BPMNShape id="Shape_Task_CloseRecoveryCase" bpmnElement="Task_CloseRecoveryCase">
        <dc:Bounds x="1280" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event Shape -->
      <bpmndi:BPMNShape id="Shape_EndEvent_CaseClosed" bpmnElement="EndEvent_CaseClosed">
        <dc:Bounds x="1430" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1417" y="143" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges / Sequence Flows -->
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="400" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="500" y="118" />
        <di:waypoint x="550" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="650" y="118" />
        <di:waypoint x="700" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ManagerApproval" bpmnElement="Flow_ManagerApproval">
        <di:waypoint x="725" y="143" />
        <di:waypoint x="725" y="220" />
        <di:waypoint x="800" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_AutoApprove" bpmnElement="Flow_AutoApprove">
        <di:waypoint x="750" y="118" />
        <di:waypoint x="950" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="900" y="220" />
        <di:waypoint x="975" y="220" />
        <di:waypoint x="975" y="143" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="1000" y="118" />
        <di:waypoint x="1050" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1150" y="118" />
        <di:waypoint x="1200" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1236" y="118" />
        <di:waypoint x="1280" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1380" y="118" />
        <di:waypoint x="1430" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
